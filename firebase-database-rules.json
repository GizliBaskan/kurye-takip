{
  "rules": {
    ".read": false,
    ".write": false,
    "kullanicilar": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        "kayitlar": {
          ".validate": true
        },
        "garaj": {
          ".validate": true
        }
      }
    }
  }
}
